DATABASE_URL="postgresql://alvim:alvim@127.0.0.1:5433/portal_alvim?schema=public"
PORT=3001
CORS_ORIGIN="http://localhost:3000,http://localhost:8081"

JWT_ACCESS_SECRET="change-me-access"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_REFRESH_EXPIRES_IN="7d"

FILE_STORAGE_DRIVER="local"
FILE_STORAGE_LOCAL_PATH="./storage"

# Envio de e-mail (Resend) — usado para enviar a Ordem de Serviço em PDF aos
# usuários-cliente marcados para receber notificações. Sem RESEND_API_KEY, o
# botão "Enviar agendamento para cliente" retorna erro em vez de falhar em silêncio.
# Cada fluxo de e-mail pode usar seu próprio remetente (ver SCHEDULE_EMAIL_FROM
# em send-schedule-to-client.use-case.ts) — MAIL_FROM_EMAIL é só o fallback
# para quando um fluxo não especifica o seu.
RESEND_API_KEY=""
MAIL_FROM_EMAIL="agendamentos@alvimanalises.com.br"

# Base do app Next.js — usada para montar o link "ver no portal" nos e-mails.
WEB_APP_URL="http://localhost:3000"
